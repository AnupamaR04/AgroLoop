# AgroLoop Frontend Environment Variables
# Copy this file to .env and provide your project keys
# Note: In browser apps, only public/anonymous keys should be prefixed with VITE_

# Supabase Project Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: External API integration flags (Demo fallbacks used automatically when not provided)
# Note: Sensitive AI / Weather provider private keys must reside strictly in Supabase Edge Functions / Vault
VITE_ENABLE_SATELLITE_DEMO=true
VITE_ENABLE_WEATHER_API=false
VITE_APP_ENV=development

